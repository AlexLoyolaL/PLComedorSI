rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========= FUNCIONES DE ROL OPTIMIZADAS (Short-Circuit) =========
    function signedIn() {
      return request.auth != null;
    }
    function getRoles() {
      return get(/databases/$(database)/documents/app/roles).data;
    }
    function isRoot() {
      return signedIn() && getRoles().root[request.auth.uid] == true;
    }
    // Al poner el rol superior PRIMERO, evitamos que Firebase busque en mapas donde el usuario no está
    function isAdmin() {
      return signedIn() && (isRoot() || getRoles().administradores[request.auth.uid] == true);
    }
    function isAdministrativo() {
      return signedIn() && (isAdmin() || getRoles().administrativos[request.auth.uid] == true);
    }
    function isCocina() {
      return signedIn() && (isAdmin() || getRoles().cocina[request.auth.uid] == true);
    }
    function isVisor() {
      return signedIn() && (
        isAdmin() ||
        getRoles().directores[request.auth.uid] == true ||
        getRoles().gabinete[request.auth.uid] == true
      );
    }
    function isGabinete() {
      return signedIn() && (isAdmin() || getRoles().gabinete[request.auth.uid] == true);
    }
    function isGabineteStaff() {
      return signedIn() && getRoles().gabinete[request.auth.uid] == true;
    }
    function isCobrosStaff() {
      return signedIn() && getRoles().cobradores[request.auth.uid] != null;
    }
    function canAccessCobrosCenter(centerId) {
      return isAdministrativo() || isVisor() || (
        isCobrosStaff() && centerId in getRoles().cobradores[request.auth.uid].centers
      );
    }
    function canOperateCobrosCenter(centerId) {
      return isAdministrativo() || (
        isCobrosStaff() && centerId in getRoles().cobradores[request.auth.uid].centers
      );
    }
    function conceptsAllowedForCenter(data) {
      return data.conceptKeys is list
        && data.conceptKeys.size() > 0
        && (
          (data.centerId == 'PUERTO_LIBRE' && data.conceptKeys.hasOnly([
            'BONO_CONTRIBUCION', 'LOCKER', 'INVITADO', 'PILETA'
          ]))
          || (data.centerId == 'ANEXO_19' && data.conceptKeys.hasOnly([
            'BONO_CONTRIBUCION', 'ACTIVIDAD_1_SEMANAL', 'ACTIVIDAD_2_SEMANAL'
          ]))
          || (data.centerId == 'CENTRO_35' && data.conceptKeys.hasOnly([
            'INSCRIPCION_ACTIVIDADES', 'ACTIVIDAD_1_SEMANAL', 'ACTIVIDAD_2_SEMANAL'
          ]))
        );
    }
    function cobrosDayIsOpen(data) {
      return data.closureId == data.dateKey + '_' + data.centerId
        && !exists(/databases/$(database)/documents/administrative_closures/$(data.closureId));
    }
    function isStaff() {
      return signedIn() && (isAdministrativo() || isCocina() || isVisor());
    }

    // ========= COLECCIONES =========

    // --- ETL de Usuarios (Perfil e Email) ---
    match /users/{userId} {
      // Un usuario puede crear/actualizar su propio perfil silenciosamente al loguearse.
      // El ROOT puede leer todos los perfiles para buscar por email y asignar accesos.
      allow read, write: if signedIn() && (request.auth.uid == userId || isRoot());
    }

    match /app/roles {
      allow read: if signedIn();
      allow write: if isRoot();
    }

    match /sales/{id} {
      allow read: if isAdministrativo() || isCocina() || isVisor();
      allow create, update: if isAdministrativo();
      allow delete: if false;
    }

    // --- Cobros administrativos: bono, lockers, invitados y pileta ---
    // Es un circuito independiente de las ventas automatizadas del comedor.
    match /administrative_payments/{id} {
      allow read: if canAccessCobrosCenter(resource.data.centerId);
      allow create: if canOperateCobrosCenter(request.resource.data.centerId)
        && cobrosDayIsOpen(request.resource.data)
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.source == 'APP'
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && conceptsAllowedForCenter(request.resource.data)
        && request.resource.data.operator.uid == request.auth.uid
        && request.resource.data.receiptNumber is string;
      allow update: if canOperateCobrosCenter(resource.data.centerId)
        && cobrosDayIsOpen(resource.data)
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'VOID'
        && request.resource.data.voidedBy.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'voidedAt', 'voidedBy', 'voidReason'
        ]);
      // Los errores se anulan con motivo y responsable; nunca se borran.
      allow delete: if false;
    }

    // Cierres diarios inmutables de Cobros, separados por fecha y sede.
    match /administrative_closures/{id} {
      allow read: if
        (id.matches('.*_PUERTO_LIBRE') && canAccessCobrosCenter('PUERTO_LIBRE'))
        || (id.matches('.*_ANEXO_19') && canAccessCobrosCenter('ANEXO_19'))
        || (id.matches('.*_CENTRO_35') && canAccessCobrosCenter('CENTRO_35'));
      allow create: if canOperateCobrosCenter(request.resource.data.centerId)
        && id == request.resource.data.dateKey + '_' + request.resource.data.centerId
        && request.resource.data.closedBy.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /dayAgg/{day} {
      allow read: if isCocina() || isAdministrativo() || isVisor();
      allow write: if isAdministrativo();
    }

    match /settings_day/{day} {
      allow read: if isAdministrativo() || isVisor();
      allow write: if isAdmin();
    }

    match /membersDayIndex/{id} {
      allow read: if isAdministrativo() || isVisor();
      allow write: if isAdministrativo();
    }

    match /adminAdds/{id} {
      allow read: if isAdministrativo() || isCocina() || isVisor();
      allow write: if isAdmin();
    }

    // --- EL PADRÓN DEL GABINETE SOCIAL ---
    match /subsidized_members/{id} {
      allow read: if isStaff();
      allow create, delete: if isRoot() || isGabinete();
      allow update: if isAdministrativo() || isRoot() || isGabinete();
    }

    // --- Alertas de Gabinete visibles en Caja ---
    match /member_alerts/{dni} {
      // Caja necesita leer la alerta puntual del socio. Gabinete también
      // lista las alertas activas desde su módulo.
      allow read: if isStaff();

      // Solo Gabinete Social y Root administran su contenido. "Eliminar"
      // en la interfaz es una baja lógica (active=false) para conservar trazabilidad.
      allow create, update: if isRoot() || isGabineteStaff();
      // La eliminación física solo se usa al borrar por completo un socio inválido.
      allow delete: if isRoot();
    }

    // --- AUDITORÍA DE RENDICIONES (PDFs y Balances) ---
    match /rendiciones_audit/{day} {
      // Root, Admins, Visores y Administrativos pueden ver el historial
      allow read: if isAdministrativo() || isVisor();
      // Administrativos (los que cierran la caja) y superiores pueden guardarla
      allow write: if isAdministrativo();
    }

    // --- Mapeo de carnets (QR -> DNI) ---
    // Antes: cualquier usuario logueado, sin importar el rol, podía leer y
    // escribir acá. Se restringe a quienes realmente vinculan carnets:
    // cajeros (al resolver un carnet viejo en una venta) y Gabinete Social
    // (al dar de alta o reparar carnets viejos).
    match /qr_mappings/{document} {
      allow read: if isStaff() || isCobrosStaff();
      allow write: if isAdministrativo() || isGabinete() || isCobrosStaff();
    }

    // --- Auditoría de venta de lotes (Mercado Pago) ---
    // Antes: cualquier usuario logueado podía escribir acá directamente, lo
    // que permitía fabricar un "pago aprobado" falso y autoacreditarse
    // viandas sin pagar. La única escritura legítima es la del Cloud
    // Function mpWebhook, que usa el Admin SDK y no depende de estas reglas.
    match /bundle_sales/{document} {
      allow read: if isAdministrativo() || isVisor();
      allow write: if false;
    }

    match /members/{id} {
      // Todos los perfiles habilitados pueden consultar el padrón central.
      allow read: if isStaff() || isCobrosStaff();

      // Caja, administrativos y administradores pueden mantener la ficha completa.
      allow create, update: if isAdministrativo();

      // Gabinete mantiene únicamente nombre y apellido en la ficha maestra.
      allow create: if isGabineteStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'dni', 'firstName', 'name', 'lastName', 'updatedAt', 'updatedBy'
        ]);
      allow update: if isGabineteStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'dni', 'firstName', 'name', 'lastName', 'updatedAt', 'updatedBy'
        ]);

      // La eliminación física sigue reservada a ROOT por ser destructiva.
      allow delete: if isRoot();
    }

    // --- Historial inmutable de ediciones y eliminaciones de socios ---
    match /member_audit/{id} {
      allow read: if isStaff();
      allow create: if isAdministrativo();
      allow update, delete: if false;
    }

    // Cerrar cualquier otra colección por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
